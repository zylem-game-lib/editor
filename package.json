{
	"name": "@zylem/editor",
	"version": "0.9.1",
	"type": "module",
	"description": "SolidJS debug UI and scene editor for Zylem games. Talks to a running @zylem/game-lib game over the typed @zylem/bridge channel.",
	"license": "MIT",
	"author": "Tim Cool",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zylem-game-lib/editor.git"
	},
	"homepage": "https://github.com/zylem-game-lib/editor#readme",
	"bugs": {
		"url": "https://github.com/zylem-game-lib/editor/issues"
	},
	"keywords": [
		"zylem",
		"editor",
		"debug-ui",
		"solid-js",
		"three",
		"game-engine"
	],
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=10.32.1"
	},
	"packageManager": "pnpm@10.33.0",
	"main": "./dist/zylem-editor.js",
	"module": "./dist/zylem-editor.js",
	"types": "./dist/zylem-editor.d.ts",
	"exports": {
		".": {
			"types": "./dist/zylem-editor.d.ts",
			"import": "./dist/zylem-editor.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"dev": "vite --host",
		"build": "tsup",
		"build:watch": "tsup --watch",
		"build:production": "cross-env NODE_ENV=production tsup",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "pnpm run build:production && vitest run"
	},
	"dependencies": {
		"@kobalte/core": "^0.13.11",
		"@solidjs/router": "^0.14.0",
		"@zylem/bridge": "^0.9.0",
		"@zylem/ui": "^0.8.11",
		"lucide-solid": "^1.48.0",
		"solid-js": "^1.9.9",
		"valtio": "^2.1.7"
	},
	"peerDependencies": {
		"@zylem/game-lib": "^0.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.7",
		"@types/three": "^0.185.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"@zylem/behaviors": "^0.8.9",
		"@zylem/game-lib": "^0.9.0",
		"cross-env": "^10.1.0",
		"esbuild": "^0.25.0",
		"esbuild-plugin-solid": "^0.6.0",
		"happy-dom": "^18.0.1",
		"three": "0.185.1",
		"tsup": "^8.5.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "7.0.4",
		"vite-plugin-solid": "^2.11.8",
		"vitest": "^4.0.9"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"msgpackr-extract"
		],
		"overrides": {
			"@types/three": "0.185.1",
			"three": "0.185.1",
			"@zylem/bridge": "^0.9.0"
		}
	}
}
